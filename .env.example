# Neon Postgres connection strings.
#
# DATABASE_URL: pooled connection (Connection Pooling ON) used by the Next.js
# app at runtime via the pg driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# DIRECT_URL: direct connection (Connection Pooling OFF) used by the Prisma CLI
# for schema pushes, migrations, and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
