// Prisma 7: TS client generator emitting into the project (not node_modules).
// Runtime connection is provided by a driver adapter (see src/db/index.ts),
// so the datasource block only declares the provider.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  Foundation
  Flow
  Freedom
}

model Level {
  id         String      @id @default(cuid())
  name       String      @unique // "Red", "Dark Green", ...
  tier       Tier
  colorHex   String // UI accent
  order      Int
  flashcards Flashcard[]
}

// Leaf content: a level, or a level + type (pack). Matches seed docs
// { level, type, pairs }.
model Flashcard {
  id              String  @id @default(cuid())
  level           Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  levelId         String
  type            String? // null = single-set level; else "Pack 1"...
  hebrew          String
  english         String
  transliteration String?
  order           Int

  @@index([levelId, type])
}
